@todo_api_HostAddress = http://localhost:5256

### Get all tasks
GET {{todo_api_HostAddress}}/todos
Accept: application/json

### Create a new task
POST {{todo_api_HostAddress}}/todos
Content-Type: application/json

{
    "title": "Learn ASP.NET Core",
    "isCompleted": false
}

###update task 
PUT {{todo_api_HostAddress}}/todos/2
Content-Type: application/json

{
    "id": 2,
    "title": "Build to-do API",
    "isCompleted": false
}

### Delete a task
DELETE {{todo_api_HostAddress}}/todos/2

### Get all tasks
GET http://localhost:5256/todos
Accept: application/json